# llmcord-rag-piighost environment template.
# Copy this file to `.env` and fill in what you use. It is read at process start
# (python-dotenv). Any config.yaml setting can point at a variable by appending
# "_env" to its name (e.g. `bot_token_env: DISCORD_BOT_TOKEN`).

# --- Discord bot (required) ---
# discord.com/developers/applications -> your app -> Bot -> Reset Token
# (also enable "MESSAGE CONTENT INTENT" there)
DISCORD_BOT_TOKEN=
# Same app -> OAuth2 -> Client ID
DISCORD_CLIENT_ID=

# --- LLM providers (fill in the ones you actually use) ---
# Key for the provider behind the local piighost-API server (config.yaml: providers.nanogpt,
# base_url http://127.0.0.1:8000/openai/v1). In my setup the piighost-API server forwards this key
# to the upstream (nano-gpt.com), so this is my nano-gpt key.
NANOGPT_API_KEY=
# Only if you also run a local AnythingLLM instance (config.yaml: providers.anythingllm)
ANYTHINGLLM_API_KEY=
# Standard providers, if you use them directly
OPENROUTER_API_KEY=
OPENAI_API_KEY=
X_AI_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_API_KEY=

# --- PII de-identification server (used by compose.yaml) ---
# Generate both with the piighost image (see README, "Start the piighost-API server"):
#   docker run --rm ghcr.io/athroniaeth/piighost-api:latest /app/.venv/bin/keyshield generate
#   docker run --rm ghcr.io/athroniaeth/piighost-api:latest /app/.venv/bin/keyshield pepper
# API_KEY protects the piighost-API server's direct REST endpoints (compose loads it as
# API_KEY_default); reuse your API_KEY_DEV value or generate a second key.
API_KEY=
API_KEY_DEV=
SECRET_PEPPER=

# --- optional ---
# Upstream the piighost-API server forwards to (compose.yaml defaults to
# nano-gpt.com; change it if you use a different OpenAI-compatible provider):
# PIIGHOST_OPENAI_UPSTREAM=https://api.openai.com/v1
#
# Uncomment AFTER the embedding model (BAAI/bge-small-en-v1.5) is cached locally,
# to skip Hugging Face network checks at startup:
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
